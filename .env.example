# Task 35 — .env.example
# ------------------------------------------------------------
# Tệp mẫu, KHÔNG chứa giá trị thật. Sao chép sang `.env` và điền giá trị
# do Lovable Cloud cấp. `.env` không được commit.
#
# Quy ước:
#   VITE_*  → nhúng vào bundle client (build-time). Chỉ chứa key CÔNG KHAI.
#   không tiền tố → CHỈ đọc ở server (createServerFn / server routes / edge).
#                    KHÔNG BAO GIỜ đưa vào code client.
# ------------------------------------------------------------

# --- Client (an toàn để nhúng vào bundle) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=<project-ref>

# --- Server (KHÔNG có tiền tố VITE_, không bao giờ import từ code client) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_PROJECT_ID=<project-ref>

# --- Server-only, tuyệt mật (do Lovable Cloud tự inject ở môi trường thật) ---
# SUPABASE_SERVICE_ROLE_KEY=<KHÔNG commit; chỉ dùng trong client.server.ts>
# LOVABLE_API_KEY=<auto-provisioned bởi Lovable Cloud>

# --- Tuỳ chọn ứng dụng ---
# TELEGRAM_BOT_TOKEN=
# RESEND_API_KEY=
